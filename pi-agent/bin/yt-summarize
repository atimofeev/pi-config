#!/usr/bin/env bash
# yt-summarize — extract YouTube transcript for summarization
# Outputs: TITLE line + cleaned transcript to stdout
# Exit codes:
#   0 - success (title + transcript)
#   1 - no transcript available (title may be extracted)
#   2 - rate limited / IP blocked (title may be extracted)
#   3 - extraction error
# Usage: yt-summarize <youtube-url>

set -euo pipefail
shopt -s nullglob

[[ $# -ge 1 ]] || { echo "USAGE: yt-summarize <youtube-url>" >&2; exit 3; }

url="$1"
tmp="$(mktemp -d)"
cleanup() { rm -rf "$tmp"; }
trap cleanup EXIT

# --- yt-dlp invocation ---
# Prefer PATH yt-dlp, fall back to nix shell (includes nodejs for JS challenges)
if command -v yt-dlp &>/dev/null; then
    YT_DLP=(yt-dlp)
elif command -v nix &>/dev/null; then
    # nodejs enables deno/node JS runtime for solving YouTube challenges
    YT_DLP=(nix shell nixpkgs#yt-dlp nixpkgs#nodejs -c yt-dlp)
else
    echo "ERROR: yt-dlp not found and nix not available. Install yt-dlp or nix." >&2
    exit 3
fi

# --- Helper: detect IP block / bot detection ---
is_bot_blocked() {
    grep -qi "sign in to confirm\|LOGIN_REQUIRED\|bot\|not a bot" "$tmp/err" 2>/dev/null
}

# --- Step 1: Get title ---
# Try yt-dlp first, fall back to curl-based HTML extraction
"${YT_DLP[@]}" --print "%(title)s" "$url" > "$tmp/title.txt" 2> "$tmp/title_err" || true
title="$(head -n 1 "$tmp/title.txt" 2>/dev/null || true)"

if [[ -z "$title" ]] || [[ "$title" == "NA" ]] || is_bot_blocked; then
    # Fallback: parse title from YouTube watch page HTML
    curl -sS --max-time 15 \
        -H "User-Agent: Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/135.0.0.0 Safari/537.36" \
        -H "Accept-Language: en-US,en;q=0.9" \
        "$url" 2>/dev/null | grep -oP '(?<="title":\{"runs":\[\{"text":")([^"]+)' | head -1 > "$tmp/curl_title.txt" 2>/dev/null || true
    curl_title="$(head -n 1 "$tmp/curl_title.txt" 2>/dev/null || true)"
    if [[ -n "$curl_title" ]]; then
        title="$curl_title"
    elif [[ -z "$title" ]] || [[ "$title" == "NA" ]]; then
        title="Unknown Title"
    fi
fi

# --- Step 2: Download subtitles ---
# CRITICAL: use both --write-subs (manual/regular captions) and --write-auto-subs (auto-generated)
# Previously only --write-auto-subs was used, missing all manually uploaded captions
try_download() {
    local lang="$1"
    "${YT_DLP[@]}" \
        --skip-download \
        --write-subs \
        --write-auto-subs \
        --sub-langs "$lang" \
        --sub-format "vtt" \
        --ignore-errors \
        -o "$tmp/%(id)s.%(ext)s" \
        "$url" > /dev/null 2> "$tmp/err" || true
}

find_sub() {
    for f in "$tmp"/*.vtt "$tmp"/*.srt; do
        [[ -f "$f" ]] || continue
        [[ "$f" == *.live_chat.* ]] && continue
        echo "$f"
        return 0
    done
    return 1
}

rate_limited=0
bot_blocked=0
# Try English first, then Russian, then broad set of languages
for lang in "en" "ru" "en,en-US,en-GB,ru,fr,de,es,pt,it,ja,ko,zh"; do
    try_download "$lang"
    if sub=$(find_sub); then
        break
    fi
    if grep -qi "429\|too many requests\|rate limit" "$tmp/err" 2>/dev/null; then
        rate_limited=1
        continue
    fi
    if is_bot_blocked; then
        bot_blocked=1
        continue
    fi
done

# --- Output title (always) ---
echo "TITLE:"
echo "$title"
echo "---TRANSCRIPT---"

# --- Handle missing transcript ---
if ! sub=$(find_sub); then
    if [[ "$bot_blocked" -eq 1 ]]; then
        echo "ERROR: YouTube bot detection blocked request (IP likely datacenter/VPS). Use proxy or VPN." >&2
        exit 2
    fi
    if [[ "$rate_limited" -eq 1 ]]; then
        echo "ERROR: YouTube rate limited on all languages. Wait and retry." >&2
        exit 2
    fi
    echo "ERROR: No transcript available (tried regular + auto-generated captions in 11 languages)" >&2
    exit 1
fi

# --- Step 3: Clean transcript ---
# Remove VTT/SRT formatting: headers, timestamps, HTML tags, empty lines, duplicates
sed -E \
    -e '/^WEBVTT/d' \
    -e '/^Kind:/Id' \
    -e '/^Language:/Id' \
    -e '/^NOTE[[:space:]]/d' \
    -e '/^[0-9]+$/d' \
    -e '/^[0-9]{2}:[0-9]{2}:[0-9]{2}\.[0-9]+ --> /d' \
    -e '/align:/Id' \
    -e 's/<[^>]+>//g' \
    -e 's/\{[^}]+\}//g' \
    -e '/^[[:space:]]*$/d' \
    "$sub" | awk '!seen[$0]++' > "$tmp/clean.txt"

# --- Step 4: Output transcript (trim if > 600 lines) ---
line_count="$(wc -l < "$tmp/clean.txt")"

if [[ "$line_count" -le 600 ]]; then
    cat "$tmp/clean.txt"
else
    head -n 250 "$tmp/clean.txt"
    echo ""
    echo "[... $(( line_count - 500 )) lines omitted from middle ...]"
    echo ""
    tail -n 250 "$tmp/clean.txt"
fi
