#!/usr/bin/env bash
# yt-summarize — extract YouTube transcript for summarization
# Outputs: TITLE line + cleaned transcript to stdout
# Exit codes:
#   0 - success (title + transcript)
#   1 - no transcript available (title may be extracted)
#   2 - rate limited / IP blocked (title may be extracted)
#   3 - extraction error
# Usage: yt-summarize [--save DIR] <youtube-url>

set -euo pipefail
shopt -s nullglob

save_dir=""
if [[ "${1:-}" == "--save" ]]; then
    [[ $# -ge 3 ]] || { echo "USAGE: yt-summarize [--save DIR] <youtube-url>" >&2; exit 3; }
    save_dir="$2"
    shift 2
fi

[[ $# -ge 1 ]] || { echo "USAGE: yt-summarize [--save DIR] <youtube-url>" >&2; exit 3; }

url="$1"

# --- Extract video ID for caching ---
extract_video_id() {
    local u="$1"
    [[ "$u" =~ youtube\.com/watch\?.*v=([A-Za-z0-9_-]{11}) ]] && { echo "${BASH_REMATCH[1]}"; return 0; }
    [[ "$u" =~ youtu\.be/([A-Za-z0-9_-]{11}) ]] && { echo "${BASH_REMATCH[1]}"; return 0; }
    [[ "$u" =~ youtube\.com/shorts/([A-Za-z0-9_-]{11}) ]] && { echo "${BASH_REMATCH[1]}"; return 0; }
    [[ "$u" =~ youtube\.com/embed/([A-Za-z0-9_-]{11}) ]] && { echo "${BASH_REMATCH[1]}"; return 0; }
    if command -v sha256sum &>/dev/null; then
        echo "$u" | sha256sum | cut -d' ' -f1
    else
        echo "$u" | tr -c '[:alnum:]' '_' | head -c 64
    fi
}

video_id="$(extract_video_id "$url")"

# --- Cache ---
cache_dir="${YT_SUMMARIZE_CACHE_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/yt-summarize}"
cache_file="$cache_dir/${video_id}.txt"

if [[ -f "$cache_file" ]]; then
    cat "$cache_file"
    if [[ -n "$save_dir" ]]; then
        mkdir -p "$save_dir"
        cp "$cache_file" "$save_dir/${video_id}.txt"
    fi
    exit 0
fi

tmp="$(mktemp -d)"
cleanup() { rm -rf "$tmp"; }
trap cleanup EXIT

# --- yt-dlp invocation ---
if command -v yt-dlp &>/dev/null; then
    YT_DLP_BASE=(yt-dlp)
elif command -v nix &>/dev/null; then
    YT_DLP_BASE=(nix shell nixpkgs#yt-dlp nixpkgs#nodejs -c yt-dlp)
else
    echo "ERROR: yt-dlp not found and nix not available. Install yt-dlp or nix." >&2
    exit 3
fi

run_ytdlp() {
    if command -v timeout &>/dev/null; then
        timeout 90 "${YT_DLP_BASE[@]}" "$@" --socket-timeout 30
    else
        "${YT_DLP_BASE[@]}" "$@" --socket-timeout 30
    fi
}

# --- Helpers ---
is_bot_blocked() {
    grep -qi "sign in to confirm\|LOGIN_REQUIRED\|bot\|not a bot" "$tmp/err" 2>/dev/null
}

is_rate_limited() {
    grep -qi "429\|too many requests\|rate limit" "$tmp/err" 2>/dev/null
}

# --- Step 1: Get title ---
# Prefer yt-dlp -J for metadata (single call, JSON saved for possible reuse)
run_ytdlp -J --skip-download "$url" > "$tmp/info.json" 2> "$tmp/info_err" || true

title=""
if [[ -s "$tmp/info.json" ]]; then
    if command -v python3 &>/dev/null; then
        title="$(python3 -c "import json; d=json.load(open('$tmp/info.json')); print(d.get('title',''))" 2>/dev/null || true)"
    else
        title="$(grep -oP '"title"\s*:\s*"\K[^"]+' "$tmp/info.json" | head -1 2>/dev/null || true)"
    fi
fi

# Fallback: --print title
if [[ -z "$title" ]] || [[ "$title" == "NA" ]]; then
    run_ytdlp --print "%(title)s" "$url" > "$tmp/title.txt" 2> "$tmp/title_err" || true
    title="$(head -n 1 "$tmp/title.txt" 2>/dev/null || true)"
fi

# Fallback: oEmbed
if [[ -z "$title" ]] || [[ "$title" == "NA" ]]; then
    curl -sS --max-time 15 \
        -G "https://www.youtube.com/oembed" \
        --data-urlencode "url=$url" \
        --data-urlencode "format=json" \
        > "$tmp/oembed.json" 2>/dev/null || true
    if [[ -s "$tmp/oembed.json" ]]; then
        if command -v python3 &>/dev/null; then
            title="$(python3 -c "import json; d=json.load(open('$tmp/oembed.json')); print(d.get('title',''))" 2>/dev/null || true)"
        else
            title="$(grep -oP '"title"\s*:\s*"\K[^"]+' "$tmp/oembed.json" | head -1 2>/dev/null || true)"
        fi
    fi
fi

if [[ -z "$title" ]] || [[ "$title" == "NA" ]]; then
    title="Unknown Title"
fi

# --- Step 2: Download subtitles ---
langs="${YT_SUMMARIZE_LANGS:-en,en-US,en-GB,ru,fr,de,es,pt,it,ja,ko,zh}"

run_ytdlp \
    --skip-download \
    --write-subs \
    --write-auto-subs \
    --sub-langs "$langs" \
    --sub-format "vtt" \
    --ignore-errors \
    -o "$tmp/%(id)s.%(ext)s" \
    "$url" > /dev/null 2> "$tmp/err" || true

find_sub() {
    IFS=',' read -r -a lang_list <<< "$langs"
    for lang in "${lang_list[@]}"; do
        for f in "$tmp"/*."$lang".vtt "$tmp"/*."$lang".srt; do
            [[ -f "$f" ]] || continue
            [[ "$f" == *.live_chat.* ]] && continue
            echo "$f"
            return 0
        done
    done

    for f in "$tmp"/*.vtt "$tmp"/*.srt; do
        [[ -f "$f" ]] || continue
        [[ "$f" == *.live_chat.* ]] && continue
        echo "$f"
        return 0
    done
    return 1
}

# --- Assemble output: title + transcript header ---
{
    echo "TITLE:"
    echo "$title"
    echo "---TRANSCRIPT---"
} > "$tmp/output.txt"

# --- Handle missing transcript ---
if ! sub=$(find_sub); then
    cat "$tmp/output.txt"
    if is_bot_blocked; then
        echo "ERROR: YouTube bot detection blocked request (IP likely datacenter/VPS). Use proxy or VPN." >&2
        exit 2
    fi
    if is_rate_limited; then
        echo "ERROR: YouTube rate limited on all languages. Wait and retry." >&2
        exit 2
    fi
    echo "ERROR: No transcript available (tried regular + auto-generated captions in multiple languages)" >&2
    exit 1
fi

# --- Step 3: Clean transcript ---
sed -E \
    -e '/^WEBVTT/d' \
    -e '/^Kind:/Id' \
    -e '/^Language:/Id' \
    -e '/^NOTE[[:space:]]/d' \
    -e '/^[0-9]+$/d' \
    -e '/^[0-9]{2}:[0-9]{2}:[0-9]{2}\.[0-9]+ --> /d' \
    -e '/align:/Id' \
    -e 's/<[^>]+>//g' \
    -e 's/\{[^}]+\}//g' \
    -e '/^[[:space:]]*$/d' \
    "$sub" | awk '!seen[$0]++' > "$tmp/clean.txt"

# --- Step 4: Output transcript (trim if > 600 lines) ---
line_count="$(wc -l < "$tmp/clean.txt")"

if [[ "$line_count" -le 600 ]]; then
    cat "$tmp/clean.txt" >> "$tmp/output.txt"
else
    head -n 250 "$tmp/clean.txt" >> "$tmp/output.txt"
    echo "" >> "$tmp/output.txt"
    echo "[... $(( line_count - 500 )) lines omitted from middle ...]" >> "$tmp/output.txt"
    echo "" >> "$tmp/output.txt"
    tail -n 250 "$tmp/clean.txt" >> "$tmp/output.txt"
fi

# --- Cache and output ---
mkdir -p "$cache_dir"
cp "$tmp/output.txt" "$cache_file"
cat "$tmp/output.txt"
if [[ -n "$save_dir" ]]; then
    mkdir -p "$save_dir"
    cp "$tmp/output.txt" "$save_dir/${video_id}.txt"
fi
