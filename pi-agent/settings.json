    "npm:pi-mcp-adapter",
    "npm:@ifi/oh-pi-themes",
    "npm:pi-lmstudio",
    "npm:pi-ask-user",
    "npm:pi-subagents",
    "npm:pi-go-bars",
    "npm:pi-caveman",
